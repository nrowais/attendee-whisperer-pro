# نسخة نموذجية من متغيرات البيئة — لا تضع أي قيم سرية هنا
# Copy to .env and fill in real values. NEVER commit .env

# --- Runtime (Railway يضبطها تلقائياً) ---
NODE_ENV=production
PORT=
HOST=0.0.0.0

# --- Backend database / auth (Lovable Cloud PostgreSQL) ---
# قيم الخادم (server-side only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Client build-time (تُحقن داخل حزمة المتصفح) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- اختياري: اتصال SQL مباشر بقاعدة PostgreSQL نفسها (server-side only) ---
# غير مستخدم حالياً من التطبيق. اتركه فارغاً ما لم تضف طبقة SQL مباشرة.
# على Railway مع خدمة Postgres مستقلة: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
